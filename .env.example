# 复制为 .env 后填写。.env 已在 .gitignore 里，不会被提交。
DEEPSEEK_API_KEY=sk-your-key-here

# 模型 id。V4.1 Flash 的 id 是 deepseek-flash（展示名才叫 DeepSeek-V4.1-Flash）。
# 调用报 “model not found” 时，先用 `python -m mini_agent --models` 看账号支持哪些。
DEEPSEEK_MODEL=deepseek-flash

# 深度思考：disabled（默认，更快更省）/ enabled / auto（交给服务端，默认会开启）
# MINI_AGENT_THINKING=disabled

# 可选：自定义 API 地址（默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：单轮最多调用模型次数，防止死循环
# MINI_AGENT_MAX_STEPS=20

# 可选：采样温度（思考模式下无效）
# MINI_AGENT_TEMPERATURE=0.7

# 可选：单次请求超时秒数
# MINI_AGENT_TIMEOUT=120

# 可选：1 开启流式，0 关闭
# MINI_AGENT_STREAM=1

# 可选：工具可读写的工作目录，默认当前目录
# MINI_AGENT_WORKSPACE=.
